{
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.defaultFormatter": "vscode.typescript-language-features",
  "files.autoSave": "onFocusChange",
  "typescript.tsdk": "server/node_modules/typescript/lib",
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": false
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true
  },
  "cSpell.words": [
    "Sahil"
  ]
}
