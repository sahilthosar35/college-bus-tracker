{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Server (Node.js)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server/dist/server.js",
      "cwd": "${workspaceFolder}/server",
      "preLaunchTask": "npm: build:server"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Dev Server (tsx hot-reload)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "watch", "src/server.ts"],
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal"
    }
  ]
}
